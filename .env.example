GOVERNANCE_ENVIRONMENT=local
GOVERNANCE_PUBLIC_BASE_PATH=/api/v1
GOVERNANCE_PORT=8005
# Supervisor authentication. Set both or neither; with neither, supervisor
# routes answer 503. The database directory must exist and be writable.
# GOVERNANCE_IDENTITY_BASE_URL=http://identity-service:8002
# GOVERNANCE_SUPERVISORS_DATABASE=local/supervisors.sqlite3
# GOVERNANCE_IDENTITY_TIMEOUT_SECONDS=3
