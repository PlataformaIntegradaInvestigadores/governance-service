GOVERNANCE_ENVIRONMENT=local
GOVERNANCE_PUBLIC_BASE_PATH=/api/v1
GOVERNANCE_PORT=8005
# Supervisor authentication. The verifier origin is required for supervisor routes.
# The database directory must exist and be writable.
# GOVERNANCE_ADMIN_VERIFIER_BASE_URL=http://search-service:8001
# GOVERNANCE_DATABASE=local/governance.sqlite3
# GOVERNANCE_ADMIN_VERIFIER_TIMEOUT_SECONDS=3
# GOVERNANCE_REVIEW_WINDOW_MINUTES=1440
# Governed Q&A also needs the database above.
# GOVERNANCE_QA_UPSTREAM_BASE_URL=http://search-service:8000
# GOVERNANCE_QA_TIMEOUT_SECONDS=30
# GOVERNANCE_QA_POLICY_PATH=policies/search-qa-review.draft-1.json
# GOVERNANCE_QA_RELEASE_KEY=<random-secret-at-least-32-characters>
